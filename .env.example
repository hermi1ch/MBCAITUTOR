# Copy to .env.local. None of these are required for the open tutor
# (mock tutor + browser Web Speech). Never put secrets in client code
# except the NEXT_PUBLIC_FIREBASE_* web config values, which are public.

# --- DeepSeek (server) — tutor brain. Without this, a syllabus mock is used.
DEEPSEEK_API_KEY=

# --- Azure Speech (server) — TTS + STT. Without this, the browser Web Speech API is used.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Firebase web config (public, optional). Auth is unused; the panel is open.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server, optional, unused by the tutor).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
